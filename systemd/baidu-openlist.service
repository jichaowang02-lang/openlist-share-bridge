[Unit]
Description=OpenList Share Bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openlist-share-bridge
EnvironmentFile=/opt/openlist-share-bridge/baidu-openlist.env
ExecStart=/usr/bin/python3 /opt/openlist-share-bridge/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
